SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require
# SUPABASE_ACCESS_TOKEN is for CLI/management tasks, not runtime database access.
# Tune the async connection pool for the event size; keep within your Supabase plan limits.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# For the original Emergent environment, use these instead of SUPABASE_DB_URL:
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=market_masters
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_DEMO_DATA=false
# Required only when SEED_DEMO_DATA=true
DEMO_EMAIL=alpha@team.com
DEMO_PASSWORD=replace-with-a-local-demo-password
