# Local development template for the market-api Edge Function.
# Supabase Cloud injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
# Never expose the service-role key to the browser or commit a real value.
SUPABASE_URL=https://qpdepehmplravgxagogt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Must match the email address of the administrator in Supabase Auth.
ADMIN_EMAIL=admin@marketmasters.com
